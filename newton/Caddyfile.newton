# newton/Caddyfile.newton
#
# Site block for newton.byescaleira.com (single host, monorepo):
#   /api/*  -> judge0 API (strip prefix; Rails stays untouched upstream-mergeable)
#   /*      -> static frontend build (frontend/dist)

newton.byescaleira.com {
	# API under /api — prefix stripped before proxying
	handle_path /api/* {
		reverse_proxy localhost:2358
	}

	# Frontend static build
	handle {
		root * /opt/newton/frontend/dist
		try_files {path} /index.html
		file_server
	}

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /var/log/newton-access.log {
			roll_size 100mb
			roll_keep 10
		}
		format json
	}
}